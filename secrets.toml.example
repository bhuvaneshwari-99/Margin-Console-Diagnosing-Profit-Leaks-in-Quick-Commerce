# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Community Cloud > App > Settings > Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).
[bigquery]
project = "your-gcp-project-id"
dataset = "margin_console"
table   = "orders"

# Service account with roles: BigQuery Data Viewer (on the dataset) + BigQuery Job User (on the project)
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "margin-console@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
